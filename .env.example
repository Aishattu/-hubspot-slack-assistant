# Copy this file to .env and fill in each value. Never share .env or commit it to git.

# Slack: api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token (starts xoxb-)
SLACK_BOT_TOKEN=
# Slack: Basic Information → App-Level Tokens → token with connections:write (starts xapp-)
SLACK_APP_TOKEN=

# Claude: console.anthropic.com → API Keys (starts sk-ant-)
ANTHROPIC_API_KEY=

# HubSpot: Service Key (Settings → Integrations → Service Keys) or a legacy Private App access token
HUBSPOT_TOKEN=

# Optional: Slack member IDs allowed to propose/approve changes, comma separated (e.g. U012ABC,U034DEF).
# Leave empty to let everyone in the workspace make changes. Everyone can always read.
ALLOWED_WRITERS=
