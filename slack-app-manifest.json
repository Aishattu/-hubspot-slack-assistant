{
  "display_information": {
    "name": "HubSpot Assistant",
    "description": "Ask anything about HubSpot and update records, with approval.",
    "background_color": "#ff7a59"
  },
  "features": {
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "bot_user": { "display_name": "HubSpot Assistant", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read", "chat:write", "im:history", "im:read", "im:write",
        "channels:history", "groups:history", "reactions:write", "users:read", "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.im", "message.channels", "message.groups"]
    },
    "interactivity": { "is_enabled": true },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
